{
  "uid": "foody-review2",
  "title": "Foody DevOps & LLMOps",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests/min",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foody-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(foody_api_requests_total[5m])) * 60",
          "legendFormat": "API requests/min"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "API error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foody-prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(foody_api_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(foody_api_requests_total[5m])), 0.001)",
          "legendFormat": "API error rate"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "API latency P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foody-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(foody_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "API latency P95"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "RAG requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foody-prometheus"
      },
      "targets": [
        {
          "expr": "sum(foody_rag_requests_total)",
